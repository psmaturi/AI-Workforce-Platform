PROJECT_NAME="AI Workforce Intelligence Platform"
VERSION="1.0.0"
ENVIRONMENT="development"

# Ollama LLM Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
OLLAMA_TEMPERATURE=0.0

# Phase 3 — RAG
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_NAME="workforce_knowledge"
DOCUMENTS_DIR="./documents"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Phase 4 — Database
# Development: SQLite (no install needed)
# Production:  postgresql://user:password@localhost:5432/workforce_db
DATABASE_URL="sqlite:///./workforce.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false
